[
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true,
   "title": "Snapshot an app's UI"
  },
  "description": "Capture the frontmost app's UI as a numbered list of elements: e12 is label 12 for Click, Type, Scroll and Move. Params: use_vision (add a screenshot), use_annotation (draw the labels on it), app (another app). Call it first and after the UI changes.",
  "input_schema": {
   "properties": {
    "app": {
     "anyOf": [
      {
       "maxLength": 256,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "App name or bundle id (default: the frontmost app).",
     "title": "App"
    },
    "display": {
     "anyOf": [
      {
       "items": {
        "type": "integer"
       },
       "type": "array"
      },
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Ignored: AXPilot snapshots one app.",
     "title": "Display"
    },
    "height_reference_line": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Ignored.",
     "title": "Height Reference Line"
    },
    "region": {
     "anyOf": [
      {
       "items": {
        "type": "number"
       },
       "type": "array"
      },
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Ignored: AXPilot snapshots one app.",
     "title": "Region"
    },
    "use_annotation": {
     "default": true,
     "description": "With use_vision: draw the labels on the image.",
     "title": "Use Annotation",
     "type": "boolean"
    },
    "use_dom": {
     "default": false,
     "description": "Ignored: web content is in the accessibility tree.",
     "title": "Use Dom",
     "type": "boolean"
    },
    "use_ui_tree": {
     "default": true,
     "description": "Ignored: the element list is always returned.",
     "title": "Use Ui Tree",
     "type": "boolean"
    },
    "use_vision": {
     "default": false,
     "description": "Include a screenshot of the window.",
     "title": "Use Vision",
     "type": "boolean"
    },
    "width_reference_line": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Ignored.",
     "title": "Width Reference Line"
    }
   },
   "title": "SnapshotArguments",
   "type": "object"
  },
  "name": "Snapshot",
  "output_schema": "sha256:312907dc8afefe07",
  "title": "Snapshot an app's UI"
