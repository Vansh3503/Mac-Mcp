   "title": "Manage an app"
  },
  "description": "Launch (name: app name, bundle id or .app path), switch to (bring to front) or resize apps. resize moves/resizes the app's front window to window_loc [x, y] / window_size [w, h] (screen points); launch takes them too. launch_executable opens an .app path (no args or cwd on macOS).",
  "input_schema": {
   "properties": {
    "args": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Not supported on macOS (use Shell).",
     "title": "Args"
    },
    "cwd": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Not supported on macOS (use Shell).",
     "title": "Cwd"
    },
    "executable": {
     "anyOf": [
      {
       "maxLength": 1024,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "launch_executable: an .app path.",
     "title": "Executable"
    },
    "mode": {
     "default": "launch",
     "description": "launch | launch_executable | resize | switch.",
     "enum": [
      "launch",
      "launch_executable",
      "resize",
      "switch"
     ],
     "title": "Mode",
     "type": "string"
    },
    "name": {
     "anyOf": [
      {
       "maxLength": 1024,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "App name, bundle id or .app path.",
     "title": "Name"
    },
    "window_loc": {
     "anyOf": [
      {
       "items": {
        "type": "number"
       },
       "type": "array"
