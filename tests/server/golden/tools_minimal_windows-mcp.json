 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true,
   "title": "Wait for a condition"
  },
  "description": "Wait (polling) until text_exists, active_window, element_exists, element_enabled or focused_element holds for text / window_name in the frontmost app, up to timeout seconds (at most 60).",
  "input_schema": {
   "properties": {
    "condition": {
     "description": "What to wait for.",
     "enum": [
      "text_exists",
      "active_window",
      "element_exists",
      "element_enabled",
      "focused_element"
     ],
     "title": "Condition",
     "type": "string"
    },
    "interval": {
     "default": 0.25,
     "description": "Ignored: AXPilot chooses the polling interval.",
     "minimum": 0,
     "title": "Interval",
     "type": "number"
    },
    "text": {
     "anyOf": [
      {
       "maxLength": 500,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Text, element name or window title.",
     "title": "Text"
    },
    "timeout": {
     "default": 10.0,
     "description": "Seconds before giving up.",
     "exclusiveMinimum": 0,
     "maximum": 60,
     "title": "Timeout",
     "type": "number"
    },
    "use_dom": {
     "default": false,
     "description": "Ignored: web content is in the accessibility tree.",
     "title": "Use Dom",
     "type": "boolean"
    },
    "window_name": {
     "anyOf": [
      {
       "maxLength": 500,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Window title (active_window).",
     "title": "Window Name"
    }
   },
   "required": [
    "condition"
   ],
   "title": "WaitForArguments",
   "type": "object"
  },
  "name": "WaitFor",
  "output_schema": "sha256:f6ea3bd88513b5d8",
  "title": "Wait for a condition"
 },
 {
